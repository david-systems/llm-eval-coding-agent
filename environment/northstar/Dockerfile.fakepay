# FakePay runtime image (simulated external payment processor). Contains no Northstar code.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONPATH=/app

WORKDIR /app

COPY requirements/fakepay.txt requirements/
RUN pip install --root-user-action=ignore -r requirements/fakepay.txt

COPY fakepay/ fakepay/

EXPOSE 8100

CMD ["python", "-m", "fakepay.cli", "serve", "--port", "8100"]
