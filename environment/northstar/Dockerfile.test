# Test image: the only image that holds both packages, because the suite runs a
# private FakePay server and drives Northstar against it over HTTP.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONPATH=/app

WORKDIR /app

COPY requirements/test.txt requirements/
RUN pip install --root-user-action=ignore -r requirements/test.txt

COPY . .

CMD ["pytest"]
